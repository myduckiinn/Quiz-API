{
  "name": "quiz-api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "db:up": "docker start quiz-api || docker run -d --name quiz-api -p 127.0.0.1:27017:27017 -v quiz-api-data:/data/db mongo:8",
    "db:down": "docker stop quiz-api",
    "db:logs": "docker logs -f quiz-api",
    "db:reset": "docker rm -f quiz-api; docker volume rm quiz-api-data",
    "predev": "npm run db:up",
    "dev": "node --watch src/server.js",
    "start": "node src/server.js"
  },
  "keywords": [],
